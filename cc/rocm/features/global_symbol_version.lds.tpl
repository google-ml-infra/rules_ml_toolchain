# Generated by the global_symbol_version_configure repository rule from the
# GLOBAL_SYMBOLS_TO_VERSION environment variable - do not edit.
#
# Assigning a symbol version to a symbol stops it from satisfying another
# library's requirement for the unversioned symbol, so which symbols are
# versioned matters. XLA versions its LLVM symbols
# (GLOBAL_SYMBOLS_TO_VERSION="llvm::*,LLVM*") so that they do not clash with
# those of ROCm's bundled libLLVM.so, while leaving everything else - notably
# the libc/pthread/operator new|delete symbols ASan/TSan intercept - unmatched
# and therefore unversioned: versioning those would stop them from satisfying
# the GLIBC-versioned symbol requirements ROCm's shared libraries
# (libamdhip64.so, libhsa-runtime64.so, ...) link against, which silently
# disables sanitizer interception inside those libraries.
XLA_TEST {
  global:
    extern "C++" {
        %{cpp_symbols}    
    };
    %{symbols}
};
