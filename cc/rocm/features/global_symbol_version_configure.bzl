"""Repository rule generating the global symbol version script (.lds).

The set of symbols to version is read from the GLOBAL_SYMBOLS_TO_VERSION
environment variable, a comma separated list of linker version script patterns,
for example:

    GLOBAL_SYMBOLS_TO_VERSION="llvm::*,someother::*,somethingelse*"

Patterns containing "::" are emitted inside an `extern "C++"` block so that they
match demangled C++ names; the remaining patterns are matched against the raw
(mangled or C) symbol names. If the variable is unset or empty, "*" is used and
every global symbol is versioned.

The script itself is rendered from global_symbol_version.lds.tpl.
"""

GLOBAL_SYMBOLS_TO_VERSION = "GLOBAL_SYMBOLS_TO_VERSION"

def parse_global_symbols(value):
    """Parses the GLOBAL_SYMBOLS_TO_VERSION value into a list of patterns.

    Args:
        value: Raw environment variable value, e.g. "llvm::*,LLVM*".

    Returns:
        List of version script patterns. ["*"] if no pattern is given.
    """
    symbols = []
    for symbol in (value or "").split(","):
        # Tolerate surrounding whitespace and the trailing ";" a version script
        # would use, so that both "llvm::*" and " llvm::*; " are accepted.
        symbol = symbol.strip().rstrip(";").strip()
        if symbol and symbol not in symbols:
            symbols.append(symbol)

    if not symbols:
        return ["*"]
    return symbols

def _global_symbol_version_configure_impl(repository_ctx):
    """Implementation of the global_symbol_version_configure repository rule."""
    symbols = parse_global_symbols(
        repository_ctx.os.environ.get(GLOBAL_SYMBOLS_TO_VERSION, "*"),
    )

    # Patterns naming a C++ scope only match once the symbol is demangled, so
    # they go into the template's `extern "C++"` block; the rest are matched as
    # written.
    repository_ctx.template(
        "global_symbol_version.lds",
        repository_ctx.attr._version_script_template,
        substitutions = {
            "%{cpp_symbols}": "".join(["      %s;\n" % s for s in symbols if "::" in s]),
            "%{symbols}": "".join(["    %s;\n" % s for s in symbols if "::" not in s]),
        },
        executable = False,
    )

    repository_ctx.file(
        "BUILD",
        content = """# Auto-generated by global_symbol_version_configure

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "global_symbol_version_script",
    srcs = ["global_symbol_version.lds"],
)
""",
        executable = False,
    )

global_symbol_version_configure = repository_rule(
    implementation = _global_symbol_version_configure_impl,
    configure = True,
    environ = [GLOBAL_SYMBOLS_TO_VERSION],
    attrs = {
        "_version_script_template": attr.label(
            default = Label("//cc/rocm/features:global_symbol_version.lds.tpl"),
            allow_single_file = True,
        ),
    },
    doc = """
Generates the linker version script used by the global symbol versioning
feature from the GLOBAL_SYMBOLS_TO_VERSION environment variable.

The variable holds a comma separated list of version script patterns, e.g.
"llvm::*,someother::*,somethingelse*". Patterns containing "::" are emitted
inside an `extern "C++"` block, the rest are matched against raw symbol names.
When the variable is unset or empty, every global symbol is versioned ("*").

The generated script is exposed as
@global_symbol_version_config//:global_symbol_version_script.
""",
)
